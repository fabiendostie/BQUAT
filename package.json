{
  "name": "baqt",
  "private": false,
  "version": "1.0.0",
  "description": "BAQT unified installer - BMAD + TELIS + QUINT autonomous framework",
  "bin": {
    "baqt": "./bin/baqt.js"
  },
  "scripts": {
    "prepare": "husky",
    "format": "./bin/python-wrapper.sh -m ruff format . && prettier --write \"**/*.{md,json,yml,yaml}\"",
    "format:check": "./bin/python-wrapper.sh -m ruff format --check . && prettier --check \"**/*.{md,json,yml,yaml}\"",
    "lint": "npm run lint:py && npm run lint:md && npm run lint:json",
    "lint:json": "eslint \"**/*.json\" \"**/*.jsonc\" --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:py": "./bin/python-wrapper.sh -m ruff check .",
    "typecheck": "./bin/python-wrapper.sh -m mypy runtime cli methodology/tools installer && pyright",
    "test": "./bin/python-wrapper.sh tests/run_tests.py && ./bin/python-wrapper.sh -m pytest",
    "test:python": "./bin/python-wrapper.sh tests/run_tests.py",
    "test:pytest": "./bin/python-wrapper.sh -m pytest"
  },
  "devDependencies": {
    "@eslint/json": "^0.14.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.20.0",
    "pyright": "^1.1.407",
    "prettier": "^3.7.4"
  }
}
