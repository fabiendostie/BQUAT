#!/usr/bin/env sh

python - "$1" <<'PY'
import pathlib
import re
import sys

msg_path = sys.argv[1]
text = pathlib.Path(msg_path).read_text(encoding="utf-8").strip()
first = text.splitlines()[0] if text else ""
pattern = re.compile(r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?(!)?: .+")
if not pattern.match(first):
    print("Invalid commit message. Use Conventional Commits, e.g. 'feat: add runtime'", file=sys.stderr)
    sys.exit(1)
PY
